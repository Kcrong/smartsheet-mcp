# Smartsheet API access token (required)
# Generate at: https://help.smartsheet.com/articles/2482389-generate-API-key
SMARTSHEET_ACCESS_TOKEN=your-access-token-here

# Smartsheet API base URL (optional)
# Defaults to https://api.smartsheet.com/2.0
# Use https://api.smartsheet.eu/2.0 for EU region
# Use https://api.smartsheet.au/2.0 for AU region
# SMARTSHEET_API_BASE_URL=https://api.smartsheet.com/2.0

# HTTP request timeout in seconds (optional, default: 30)
# SMARTSHEET_TIMEOUT=30

# Log level: DEBUG, INFO, WARNING, ERROR (optional, default: INFO)
# SMARTSHEET_LOG_LEVEL=INFO
